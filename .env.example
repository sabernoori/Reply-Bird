# Neon Postgres (pooled URL is fine for serverless)
DATABASE_URL=

# Instagram API with Instagram Login (graph.instagram.com)
IG_APP_ID=
IG_APP_SECRET=
IG_VERIFY_TOKEN=
IG_ACCESS_TOKEN=
IG_USER_ID=

# Optional Graph API version, default v23.0
# IG_GRAPH_API_VERSION=v23.0

# Admin dashboard password (used to sign the session cookie)
ADMIN_PASSWORD=

# Kill switch. Set to false to log matches but send nothing.
AUTOREPLY_ENABLED=true

# Optional Telegram lead reports. Leave unset to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_REPORT_CHAT_ID=

# Optional. If set, Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
# CRON_SECRET=
